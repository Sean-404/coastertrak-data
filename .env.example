# Supabase (for analyze:supabase and publish — copy from CoasterTrak .env.local)
# The CLI loads .env.local then .env automatically (Node does not do this by itself).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CATALOG_QUALITY_BUCKET=catalog
CATALOG_QUALITY_PREFIX=coastertrak-data/latest

# Optional: Vercel AI Gateway (for ai:review CLI — copy from CoasterTrak .env.local)
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_MODEL=google/gemini-2.5-flash

# Optional: live Wikidata ingest (--live)
# WIKIDATA_USER_AGENT=CoasterTrakData/0.2 (https://github.com/Sean-404/coastertrak-data; contact@example.com)
